# Copy to .env and fill in. docker-compose reads this file automatically.

# Django settings — required. Must mirror the pharmacy/accounting apps:
# the dashboard verifies their JWTs (SSO), so a different key here breaks
# login. With DJANGO_DEBUG off (any deploy), startup FAILS if this is
# unset — there is no insecure fallback outside DEBUG/test runs.
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string

# Path on the *host* to the shared inventory SQLite. The dashboard
# reads this read/write because pipeline runs write to its own
# pipeline_log table. Default for a typical Seefmed dev box:
UPSTREAM_DB_PATH=/home/seefmed/healthcare-inventory-management/backend/db.sqlite3

# Hostnames Django will serve when DJANGO_DEBUG is off (comma-separated).
# Default: localhost,127.0.0.1. The frontend nginx forwards the original
# Host header, so include every name/IP users browse the stack with
# (e.g. the LAN IP for http://192.168.x.x:8082).
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Cross-origin API callers when DJANGO_DEBUG is off (comma-separated,
# scheme included). Default: none — the bundled nginx proxies /api/
# same-origin, so this is only needed for external frontends.
# CORS_ALLOWED_ORIGINS=https://dashboards.example.com

# Set to 1 when the stack is served over HTTPS (TLS-terminating proxy in
# front) so Django session/CSRF cookies are marked Secure. Leave 0 for
# plain-HTTP LAN deploys or the admin login breaks.
# DASHBOARD_HTTPS=0

# Optional. Defaults shown. DASHBOARD_REQUIRE_AUTH now defaults to
# "required unless DJANGO_DEBUG is on" — i.e. with this stack
# (DJANGO_DEBUG=False) auth is enforced even if the var is unset.
# Set it to 0 ONLY to deliberately run an open dashboard.
# DASHBOARD_REQUIRE_AUTH=1
# DASHBOARD_PERF_LOG=1
# GUNICORN_WORKERS=3

# Production stack (docker-compose.prod.yml). Set POSTGRES_PASSWORD
# at minimum; the rest have sensible defaults.
# POSTGRES_DB=healthcare_dashboard
# POSTGRES_USER=dashboard
POSTGRES_PASSWORD=
# DJANGO_CONN_MAX_AGE=60
