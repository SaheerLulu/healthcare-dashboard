# ============================================================
# biloop-dev — https://dev.dashboards.biloop.ai   (branch: develop)
# Copied to /opt/dashboard/biloop-dev/.env by remote-deploy.sh on
# first deploy; DJANGO_SECRET_KEY, POSTGRES_PASSWORD and
# POSTGRES_DB are derived from the pharmacy biloop-dev env
# (/opt/healthcare/biloop-dev/.env) so JWT SSO and DB access
# stay in sync with the upstream app.
# ============================================================

# Must mirror the pharmacy biloop-dev app — JWT SSO depends on it
DJANGO_SECRET_KEY=change-me

# Source + reporting database (pharmacy biloop-dev PostgreSQL on the host)
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_DB=healthcare_biloop_dev
POSTGRES_USER=healthcare
POSTGRES_PASSWORD=change-me

# Ports (exposed on the host)
FRONTEND_PORT=3031

# Hostnames Django serves (comma-separated). DJANGO_DEBUG is off in this
# stack, so the public domain MUST be listed — nginx forwards the original
# Host header. localhost stays for the in-container healthcheck.
DJANGO_ALLOWED_HOSTS=dev.dashboards.biloop.ai,localhost,127.0.0.1

# Cross-origin API callers (comma-separated, scheme included). Empty is
# correct here: the frontend nginx proxies /api/ same-origin.
CORS_ALLOWED_ORIGINS=

# Served over HTTPS (nginx + certbot on the host) → Secure cookies.
DASHBOARD_HTTPS=1

# Require JWT on every API endpoint.
DASHBOARD_REQUIRE_AUTH=1

# Incremental pipeline sync interval (seconds)
PIPELINE_SYNC_INTERVAL=300

GUNICORN_WORKERS=3
