# ============================================================
# seefmed-dev — https://dev.dashboards.seefmed.com   (branch: dev-seefmed)
# Copied to /opt/dashboard/seefmed-dev/.env by remote-deploy.sh on
# first deploy; DJANGO_SECRET_KEY, POSTGRES_PASSWORD and
# POSTGRES_DB are derived from the pharmacy seefmed-dev env
# (/opt/healthcare/seefmed-dev/.env) so JWT SSO and DB access
# stay in sync with the upstream app.
#
# NOTE: this environment keeps the pre-split dev identity —
# port 3005 and the shared healthcare_dev database.
# ============================================================

# Must mirror the pharmacy seefmed-dev app — JWT SSO depends on it
DJANGO_SECRET_KEY=change-me

# Source + reporting database (pharmacy seefmed-dev PostgreSQL on the host)
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_DB=healthcare_dev
POSTGRES_USER=healthcare
POSTGRES_PASSWORD=change-me

# Ports (exposed on the host)
FRONTEND_PORT=3005

# Hostnames Django serves (comma-separated).
DJANGO_ALLOWED_HOSTS=dev.dashboards.seefmed.com,localhost,127.0.0.1

# Cross-origin API callers. Empty: frontend nginx proxies /api/ same-origin.
CORS_ALLOWED_ORIGINS=

# Served over HTTPS (nginx + certbot on the host) → Secure cookies.
DASHBOARD_HTTPS=1

# Require JWT on every API endpoint.
DASHBOARD_REQUIRE_AUTH=1

# Incremental pipeline sync interval (seconds)
PIPELINE_SYNC_INTERVAL=300

GUNICORN_WORKERS=3
