# ============================================================
# DEV Environment Variables — healthcare-dashboard
# Copy to /opt/dashboard/dev/.env and fill in real values.
#
# The deploy workflow auto-generates this file from the pharmacy
# dev env (/opt/healthcare/dev/.env) on first run so that
# DJANGO_SECRET_KEY (shared JWT signing for SSO) and
# POSTGRES_PASSWORD match the upstream app.
# ============================================================

# Must mirror the pharmacy dev app — JWT SSO depends on it
DJANGO_SECRET_KEY=change-me

# Source + reporting database (pharmacy dev PostgreSQL on the host)
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_DB=healthcare_dev
POSTGRES_USER=healthcare
POSTGRES_PASSWORD=change-me

# Ports (exposed on the host)
DEV_FRONTEND_PORT=3005

# Hostnames Django serves (comma-separated). DJANGO_DEBUG is off in this
# stack, so the public domain MUST be listed — nginx forwards the original
# Host header. localhost stays for the in-container healthcheck.
DJANGO_ALLOWED_HOSTS=dev.dashboards.seefmed.com,localhost,127.0.0.1

# Cross-origin API callers (comma-separated, scheme included). Empty is
# correct here: the frontend nginx proxies /api/ same-origin.
CORS_ALLOWED_ORIGINS=

# This stack is served over HTTPS (nginx + certbot on the host), so mark
# Django session/CSRF cookies Secure.
DASHBOARD_HTTPS=1

# Require JWT on every API endpoint. Since the fail-closed default this
# is also what you get when the var is unset (DJANGO_DEBUG is off here);
# keep it explicit for clarity. Note: the dashboard has no login UI of
# its own yet — obtain a token from the pharmacy dev API (shared
# DJANGO_SECRET_KEY) and store it as `access_token` in localStorage.
DASHBOARD_REQUIRE_AUTH=1

# Incremental pipeline sync interval (seconds)
PIPELINE_SYNC_INTERVAL=300
